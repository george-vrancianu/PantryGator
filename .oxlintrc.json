{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["unicorn", "oxc", "typescript", "react", "jsx-a11y"],
  "categories": { "correctness": "error" },
  "rules": {
    // Off: the rule wants role="group"/"checkbox"/"progressbar"/... swapped for fieldset/input/progress
    // across ~105 elements (SwipeRow, SegmentedControl, MUI Box wrappers). That changes markup, styling
    // and screen reader output, so it needs a design decision, not a lint sweep.
    "jsx-a11y/prefer-tag-over-role": "off",
    // Off (10 findings): the autofocus calls are deliberate (sheets and dialogs move focus to their first field on open);
    // removing them would change Member-visible focus behaviour.
    "jsx-a11y/no-autofocus": "off",
    // Off on purpose (ADR 0044): import/no-cycle is not enabled yet. The move PRs rewrite imports area by
    // area and will surface cycles; revisit it after #840, once the shared groups have settled.
    "import/no-cycle": "off"
  },
  "overrides": [
    // Import rules, ADR 0044 (details: docs/agents/codebase-map.md). Override globs are relative to THIS
    // file, so they start at apps/web/. An override REPLACES the base rule's options, so the second
    // override repeats Rule B. oxlint matches the raw import string, so relative and `@/` imports both
    // need a pattern (`**/` prefix). Excluded files are today's violators; each move ticket deletes its
    // own entries and #854 empties the list. `npm run check:web-layout` proves both rules still fire.
    {
      "files": ["apps/web/src/**/*.ts", "apps/web/src/**/*.tsx"],
      "excludeFiles": [
        // #838 splits the Dashboard widget registry
        "apps/web/src/lib/dashboardLayout.ts",
        // #845 moves familyDraft into Recipes hooks/ (this test imports pages/Recipes/familyDraft)
        "apps/web/src/lib/recipeDraftContent.test.ts",
        // Cross-page test (renders PantryPage and RecipesPage): #844 keeps it under components/, so no move ticket ends this; needs a spec decision before #854
        "apps/web/src/components/RefreshScreen.test.tsx",
        // Already beside VoiceAnswerSheet and renders PantryPage and ShoppingPage: #853 does not change that; needs a spec decision before #854
        "apps/web/src/components/voice/VoiceAnswerSheet.test.tsx",
        // #846 moves Servings into components/recipe/ and rewrites this import
        "apps/web/src/pages/MealPlans/MealPlanFormPage.tsx",
        // #846 moves the Recipe row and filters into components/recipe/ and rewrites this import
        "apps/web/src/pages/MealPlans/components/RecipePickerSheet.tsx",
        // #846 moves Servings and Pantry status into components/recipe/ and rewrites this import
        "apps/web/src/pages/MealPlans/components/SlotSheet.tsx"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              // Rule B
              {
                "group": [
                  "**/Admin/components",
                  "**/Admin/components/**",
                  "**/Admin/hooks",
                  "**/Admin/hooks/**",
                  "**/Customise/components",
                  "**/Customise/components/**",
                  "**/Customise/hooks",
                  "**/Customise/hooks/**",
                  "**/Dashboard/components",
                  "**/Dashboard/components/**",
                  "**/Dashboard/hooks",
                  "**/Dashboard/hooks/**",
                  "**/Family/components",
                  "**/Family/components/**",
                  "**/Family/hooks",
                  "**/Family/hooks/**",
                  "**/Intro/components",
                  "**/Intro/components/**",
                  "**/Intro/hooks",
                  "**/Intro/hooks/**",
                  "**/MealPlans/components",
                  "**/MealPlans/components/**",
                  "**/MealPlans/hooks",
                  "**/MealPlans/hooks/**",
                  "**/Pantry/components",
                  "**/Pantry/components/**",
                  "**/Pantry/hooks",
                  "**/Pantry/hooks/**",
                  "**/Recipes/components",
                  "**/Recipes/components/**",
                  "**/Recipes/hooks",
                  "**/Recipes/hooks/**",
                  "**/Review/components",
                  "**/Review/components/**",
                  "**/Review/hooks",
                  "**/Review/hooks/**",
                  "**/Scan/components",
                  "**/Scan/components/**",
                  "**/Scan/hooks",
                  "**/Scan/hooks/**",
                  "**/Settings/components",
                  "**/Settings/components/**",
                  "**/Settings/hooks",
                  "**/Settings/hooks/**",
                  "**/Shopping/components",
                  "**/Shopping/components/**",
                  "**/Shopping/hooks",
                  "**/Shopping/hooks/**",
                  "**/SignIn/components",
                  "**/SignIn/components/**",
                  "**/SignIn/hooks",
                  "**/SignIn/hooks/**",
                  "**/SignUp/components",
                  "**/SignUp/components/**",
                  "**/SignUp/hooks",
                  "**/SignUp/hooks/**"
                ],
                "message": "Rule B: nothing outside a page area imports that area's components or hooks. Import the whole page, or move the module to the shared components/ (ADR 0044)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "apps/web/src/components/**/*.ts",
        "apps/web/src/components/**/*.tsx",
        "apps/web/src/lib/**/*.ts",
        "apps/web/src/lib/**/*.tsx"
      ],
      "excludeFiles": [
        // #838 splits the Dashboard widget registry
        "apps/web/src/lib/dashboardLayout.ts",
        // #845 moves familyDraft into Recipes hooks/ (this test imports pages/Recipes/familyDraft)
        "apps/web/src/lib/recipeDraftContent.test.ts",
        // Cross-page test (renders PantryPage and RecipesPage): #844 keeps it under components/, so no move ticket ends this; needs a spec decision before #854
        "apps/web/src/components/RefreshScreen.test.tsx",
        // Already beside VoiceAnswerSheet and renders PantryPage and ShoppingPage: #853 does not change that; needs a spec decision before #854
        "apps/web/src/components/voice/VoiceAnswerSheet.test.tsx",
        // #846 moves Servings into components/recipe/ and rewrites this import
        "apps/web/src/pages/MealPlans/MealPlanFormPage.tsx",
        // #846 moves the Recipe row and filters into components/recipe/ and rewrites this import
        "apps/web/src/pages/MealPlans/components/RecipePickerSheet.tsx",
        // #846 moves Servings and Pantry status into components/recipe/ and rewrites this import
        "apps/web/src/pages/MealPlans/components/SlotSheet.tsx"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              // Rule A
              {
                "group": ["**/pages", "**/pages/**"],
                "message": "Rule A: shared components and lib/ never import pages/, relative or through @/. Move the shared piece into components/ or lib/, or put the guard in routing/ (ADR 0044)."
              },
              // Rule B (repeated, see above)
              {
                "group": [
                  "**/Admin/components",
                  "**/Admin/components/**",
                  "**/Admin/hooks",
                  "**/Admin/hooks/**",
                  "**/Customise/components",
                  "**/Customise/components/**",
                  "**/Customise/hooks",
                  "**/Customise/hooks/**",
                  "**/Dashboard/components",
                  "**/Dashboard/components/**",
                  "**/Dashboard/hooks",
                  "**/Dashboard/hooks/**",
                  "**/Family/components",
                  "**/Family/components/**",
                  "**/Family/hooks",
                  "**/Family/hooks/**",
                  "**/Intro/components",
                  "**/Intro/components/**",
                  "**/Intro/hooks",
                  "**/Intro/hooks/**",
                  "**/MealPlans/components",
                  "**/MealPlans/components/**",
                  "**/MealPlans/hooks",
                  "**/MealPlans/hooks/**",
                  "**/Pantry/components",
                  "**/Pantry/components/**",
                  "**/Pantry/hooks",
                  "**/Pantry/hooks/**",
                  "**/Recipes/components",
                  "**/Recipes/components/**",
                  "**/Recipes/hooks",
                  "**/Recipes/hooks/**",
                  "**/Review/components",
                  "**/Review/components/**",
                  "**/Review/hooks",
                  "**/Review/hooks/**",
                  "**/Scan/components",
                  "**/Scan/components/**",
                  "**/Scan/hooks",
                  "**/Scan/hooks/**",
                  "**/Settings/components",
                  "**/Settings/components/**",
                  "**/Settings/hooks",
                  "**/Settings/hooks/**",
                  "**/Shopping/components",
                  "**/Shopping/components/**",
                  "**/Shopping/hooks",
                  "**/Shopping/hooks/**",
                  "**/SignIn/components",
                  "**/SignIn/components/**",
                  "**/SignIn/hooks",
                  "**/SignIn/hooks/**",
                  "**/SignUp/components",
                  "**/SignUp/components/**",
                  "**/SignUp/hooks",
                  "**/SignUp/hooks/**"
                ],
                "message": "Rule B: nothing outside a page area imports that area's components or hooks. Import the whole page, or move the module to the shared components/ (ADR 0044)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "name": "setTimeout",
            "message": "No real waits in tests. Use vi.useFakeTimers(), waitFor, findBy*, or await the real promise."
          },
          {
            "name": "setInterval",
            "message": "No real waits in tests. Use vi.useFakeTimers(), waitFor, findBy*, or await the real promise."
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "window",
            "property": "setTimeout",
            "message": "No real waits in tests. Use vi.useFakeTimers(), waitFor, findBy*, or await the real promise."
          },
          {
            "object": "window",
            "property": "setInterval",
            "message": "No real waits in tests. Use vi.useFakeTimers(), waitFor, findBy*, or await the real promise."
          },
          {
            "object": "globalThis",
            "property": "setTimeout",
            "message": "No real waits in tests. Use vi.useFakeTimers(), waitFor, findBy*, or await the real promise."
          },
          {
            "object": "globalThis",
            "property": "setInterval",
            "message": "No real waits in tests. Use vi.useFakeTimers(), waitFor, findBy*, or await the real promise."
          },
          {
            "object": "self",
            "property": "setTimeout",
            "message": "No real waits in tests. Use vi.useFakeTimers(), waitFor, findBy*, or await the real promise."
          },
          {
            "object": "self",
            "property": "setInterval",
            "message": "No real waits in tests. Use vi.useFakeTimers(), waitFor, findBy*, or await the real promise."
          }
        ]
      }
    }
  ]
}
