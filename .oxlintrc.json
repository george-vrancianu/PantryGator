{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["unicorn", "oxc", "typescript", "react", "jsx-a11y", "import"],
  "categories": { "correctness": "error" },
  "rules": {
    // Off: the rule wants role="group"/"checkbox"/"progressbar"/... swapped for fieldset/input/progress
    // across ~105 elements (SwipeRow, SegmentedControl, MUI Box wrappers). That changes markup, styling
    // and screen reader output, so it needs a design decision, not a lint sweep.
    "jsx-a11y/prefer-tag-over-role": "off",
    // Off (10 findings): the autofocus calls are deliberate (sheets and dialogs move focus to their first field on open);
    // removing them would change Member-visible focus behaviour.
    "jsx-a11y/no-autofocus": "off",
    // On (the `import` plugin adds about 0.1s to a lint run): a cycle makes module load order matter. The one that
    // existed (lib/pantry -> settings -> recipes -> pantry) is gone: `localIso` moved to lib/localIso.ts.
    "import/no-cycle": "error"
  },
  "overrides": [
    // Import rules, ADR 0044 (details: docs/agents/codebase-map.md). Override globs are relative to THIS
    // file, so they start at apps/web/. An override REPLACES the base rule's options, so the second
    // and third overrides repeat Rule B. oxlint matches the raw import string, so relative and `@/` imports both
    // need a pattern (`**/` prefix). No file is excluded: a violation is fixed by moving the
    // module, never by an `excludeFiles` entry. `npm run check:web-layout` proves both rules still fire.
    {
      "files": ["apps/web/src/**/*.ts", "apps/web/src/**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              // Rule B
              {
                "group": [
                  "**/Admin/components",
                  "**/Admin/components/**",
                  "**/Admin/hooks",
                  "**/Admin/hooks/**",
                  "**/Customise/components",
                  "**/Customise/components/**",
                  "**/Customise/hooks",
                  "**/Customise/hooks/**",
                  "**/Dashboard/components",
                  "**/Dashboard/components/**",
                  "**/Dashboard/hooks",
                  "**/Dashboard/hooks/**",
                  "**/Family/components",
                  "**/Family/components/**",
                  "**/Family/hooks",
                  "**/Family/hooks/**",
                  "**/Intro/components",
                  "**/Intro/components/**",
                  "**/Intro/hooks",
                  "**/Intro/hooks/**",
                  "**/MealPlans/components",
                  "**/MealPlans/components/**",
                  "**/MealPlans/hooks",
                  "**/MealPlans/hooks/**",
                  "**/Pantry/components",
                  "**/Pantry/components/**",
                  "**/Pantry/hooks",
                  "**/Pantry/hooks/**",
                  "**/Recipes/components",
                  "**/Recipes/components/**",
                  "**/Recipes/hooks",
                  "**/Recipes/hooks/**",
                  "**/Review/components",
                  "**/Review/components/**",
                  "**/Review/hooks",
                  "**/Review/hooks/**",
                  "**/Scan/components",
                  "**/Scan/components/**",
                  "**/Scan/hooks",
                  "**/Scan/hooks/**",
                  "**/Settings/components",
                  "**/Settings/components/**",
                  "**/Settings/hooks",
                  "**/Settings/hooks/**",
                  "**/Shopping/components",
                  "**/Shopping/components/**",
                  "**/Shopping/hooks",
                  "**/Shopping/hooks/**",
                  "**/SignIn/components",
                  "**/SignIn/components/**",
                  "**/SignIn/hooks",
                  "**/SignIn/hooks/**",
                  "**/SignUp/components",
                  "**/SignUp/components/**",
                  "**/SignUp/hooks",
                  "**/SignUp/hooks/**"
                ],
                "message": "Rule B: nothing outside a page area imports that area's components or hooks. Import the whole page, or move the module to the shared components/ (ADR 0044)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "apps/web/src/components/**/*.ts",
        "apps/web/src/components/**/*.tsx",
        "apps/web/src/lib/**/*.ts",
        "apps/web/src/lib/**/*.tsx"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              // Rule A
              {
                "group": ["**/pages", "**/pages/**"],
                "message": "Rule A: shared components and lib/ never import pages/, relative or through @/. Move the shared piece into components/ or lib/, or put the guard in routing/ (ADR 0044)."
              },
              // Rule B (repeated, see above)
              {
                "group": [
                  "**/Admin/components",
                  "**/Admin/components/**",
                  "**/Admin/hooks",
                  "**/Admin/hooks/**",
                  "**/Customise/components",
                  "**/Customise/components/**",
                  "**/Customise/hooks",
                  "**/Customise/hooks/**",
                  "**/Dashboard/components",
                  "**/Dashboard/components/**",
                  "**/Dashboard/hooks",
                  "**/Dashboard/hooks/**",
                  "**/Family/components",
                  "**/Family/components/**",
                  "**/Family/hooks",
                  "**/Family/hooks/**",
                  "**/Intro/components",
                  "**/Intro/components/**",
                  "**/Intro/hooks",
                  "**/Intro/hooks/**",
                  "**/MealPlans/components",
                  "**/MealPlans/components/**",
                  "**/MealPlans/hooks",
                  "**/MealPlans/hooks/**",
                  "**/Pantry/components",
                  "**/Pantry/components/**",
                  "**/Pantry/hooks",
                  "**/Pantry/hooks/**",
                  "**/Recipes/components",
                  "**/Recipes/components/**",
                  "**/Recipes/hooks",
                  "**/Recipes/hooks/**",
                  "**/Review/components",
                  "**/Review/components/**",
                  "**/Review/hooks",
                  "**/Review/hooks/**",
                  "**/Scan/components",
                  "**/Scan/components/**",
                  "**/Scan/hooks",
                  "**/Scan/hooks/**",
                  "**/Settings/components",
                  "**/Settings/components/**",
                  "**/Settings/hooks",
                  "**/Settings/hooks/**",
                  "**/Shopping/components",
                  "**/Shopping/components/**",
                  "**/Shopping/hooks",
                  "**/Shopping/hooks/**",
                  "**/SignIn/components",
                  "**/SignIn/components/**",
                  "**/SignIn/hooks",
                  "**/SignIn/hooks/**",
                  "**/SignUp/components",
                  "**/SignUp/components/**",
                  "**/SignUp/hooks",
                  "**/SignUp/hooks/**"
                ],
                "message": "Rule B: nothing outside a page area imports that area's components or hooks. Import the whole page, or move the module to the shared components/ (ADR 0044)."
              }
            ]
          }
        ]
      }
    },
    // Carve-out (ADR 0044 amendment): shared tests may import pages. Later overrides replace earlier options, so this override drops Rule A for shared test files and repeats Rule B.
    {
      "files": [
        "apps/web/src/components/**/*.test.*",
        "apps/web/src/lib/**/*.test.*"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              // Rule B (repeated, see above)
              {
                "group": [
                  "**/Admin/components",
                  "**/Admin/components/**",
                  "**/Admin/hooks",
                  "**/Admin/hooks/**",
                  "**/Customise/components",
                  "**/Customise/components/**",
                  "**/Customise/hooks",
                  "**/Customise/hooks/**",
                  "**/Dashboard/components",
                  "**/Dashboard/components/**",
                  "**/Dashboard/hooks",
                  "**/Dashboard/hooks/**",
                  "**/Family/components",
                  "**/Family/components/**",
                  "**/Family/hooks",
                  "**/Family/hooks/**",
                  "**/Intro/components",
                  "**/Intro/components/**",
                  "**/Intro/hooks",
                  "**/Intro/hooks/**",
                  "**/MealPlans/components",
                  "**/MealPlans/components/**",
                  "**/MealPlans/hooks",
                  "**/MealPlans/hooks/**",
                  "**/Pantry/components",
                  "**/Pantry/components/**",
                  "**/Pantry/hooks",
                  "**/Pantry/hooks/**",
                  "**/Recipes/components",
                  "**/Recipes/components/**",
                  "**/Recipes/hooks",
                  "**/Recipes/hooks/**",
                  "**/Review/components",
                  "**/Review/components/**",
                  "**/Review/hooks",
                  "**/Review/hooks/**",
                  "**/Scan/components",
                  "**/Scan/components/**",
                  "**/Scan/hooks",
                  "**/Scan/hooks/**",
                  "**/Settings/components",
                  "**/Settings/components/**",
                  "**/Settings/hooks",
                  "**/Settings/hooks/**",
                  "**/Shopping/components",
                  "**/Shopping/components/**",
                  "**/Shopping/hooks",
                  "**/Shopping/hooks/**",
                  "**/SignIn/components",
                  "**/SignIn/components/**",
                  "**/SignIn/hooks",
                  "**/SignIn/hooks/**",
                  "**/SignUp/components",
                  "**/SignUp/components/**",
                  "**/SignUp/hooks",
                  "**/SignUp/hooks/**"
                ],
                "message": "Rule B: nothing outside a page area imports that area's components or hooks. Import the whole page, or move the module to the shared components/ (ADR 0044)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "name": "setTimeout",
            "message": "No real waits in tests. Use vi.useFakeTimers(), waitFor, findBy*, or await the real promise."
          },
          {
            "name": "setInterval",
            "message": "No real waits in tests. Use vi.useFakeTimers(), waitFor, findBy*, or await the real promise."
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "window",
            "property": "setTimeout",
            "message": "No real waits in tests. Use vi.useFakeTimers(), waitFor, findBy*, or await the real promise."
          },
          {
            "object": "window",
            "property": "setInterval",
            "message": "No real waits in tests. Use vi.useFakeTimers(), waitFor, findBy*, or await the real promise."
          },
          {
            "object": "globalThis",
            "property": "setTimeout",
            "message": "No real waits in tests. Use vi.useFakeTimers(), waitFor, findBy*, or await the real promise."
          },
          {
            "object": "globalThis",
            "property": "setInterval",
            "message": "No real waits in tests. Use vi.useFakeTimers(), waitFor, findBy*, or await the real promise."
          },
          {
            "object": "self",
            "property": "setTimeout",
            "message": "No real waits in tests. Use vi.useFakeTimers(), waitFor, findBy*, or await the real promise."
          },
          {
            "object": "self",
            "property": "setInterval",
            "message": "No real waits in tests. Use vi.useFakeTimers(), waitFor, findBy*, or await the real promise."
          }
        ]
      }
    }
  ]
}
