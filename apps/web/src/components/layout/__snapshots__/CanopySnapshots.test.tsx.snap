<div data-testid="canopy-texture" data-texture="home" aria-hidden="true"> .css-5jpfdi{position:absolute;inset:0;overflow:hidden;pointer-events:none;-webkit-mask-image:linear-gradient(205deg, #000 8%, rgba(0, 0, 0, 0.5) 55%, rgba(0, 0, 0, 0.2) 100%);-webkit-mask-image:linear-gradient(205deg, #000 8%, rgba(0, 0, 0, 0.5) 55%, rgba(0, 0, 0, 0.2) 100%);mask-image:linear-gradient(205deg, #000 8%, rgba(0, 0, 0, 0.5) 55%, rgba(0, 0, 0, 0.2) 100%);
<div > .css-18vwjdo{position:absolute;inset:0;opacity:0.17;
<div data-layer="base" data-texture="home" data-fade="idle"> .css-1ayv084{position:absolute;inset:0;
<i > .css-eozsqp{position:absolute;left:0;top:0;right:-240px;bottom:0;background-image:url(<tile:home>);-webkit-background-size:112px 112px;background-size:112px 112px;opacity:0.8;
<div data-testid="canopy-glint"> .css-12tjmid{position:absolute;inset:0;opacity:0.5;-webkit-mask-image:linear-gradient(100deg, transparent 0%, #000 50%, transparent 100%);-webkit-mask-image:linear-gradient(100deg, transparent 0%, #000 50%, transparent 100%);mask-image:linear-gradient(100deg, transparent 0%, #000 50%, transparent 100%);-webkit-mask-size:46% 100%;-webkit-mask-size:46% 100%;mask-size:46% 100%;-webkit-mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-repeat:no-repeat;-webkit-mask-position:62% 0;-webkit-mask-position:62% 0;mask-position:62% 0;-webkit-animation:pp-glint 10s ease-in-out -3s infinite;animation:pp-glint 10s ease-in-out -3s infinite;-webkit-animation-play-state:running;animation-play-state:running;
<div data-layer="glint" data-texture="home" data-fade="idle"> .css-1ayv084{position:absolute;inset:0;
<i > .css-1es0udg{position:absolute;left:0;top:0;right:-240px;bottom:0;background:var(--pp-tex-glint);-webkit-mask-image:url(<tile:home>);-webkit-mask-image:url(<tile:home>);mask-image:url(<tile:home>);-webkit-mask-size:112px 112px;-webkit-mask-size:112px 112px;mask-size:112px 112px;-webkit-mask-repeat:repeat;-webkit-mask-repeat:repeat;mask-repeat:repeat;opacity:0.8;
